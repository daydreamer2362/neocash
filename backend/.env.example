PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/neocash
DIRECT_URL=

JWT_SECRET=change-me-user
ADMIN_JWT_SECRET=change-me-admin
ADMIN_ACCOUNT_CREATION_PASS=admin@Gold11
# If JWT secrets are not set, backend derives deterministic fallback secrets.
# Set explicit values in production for stronger security and token portability.

WELCOME_BONUS=146.84
USDT_TO_INR_RATE=103
LEVEL_B_COMMISSION=0.03
LEVEL_C_COMMISSION=0.015
ORDER_EXPIRY_MINUTES=30
APP_BASE_URL=https://neocash.online

# Supports full origins, hostname-only entries, and wildcard hostnames (e.g. *.neocash.online).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://neocash.online,https://www.neocash.online
ADMIN_PANEL_ORIGINS=http://localhost:3000,http://localhost:5174
ADMIN_PANEL_API_BASE_URL=http://localhost:3000
GLOBAL_RATE_LIMIT=240
AUTH_RATE_LIMIT=20
ORDER_LOCK_SWEEP_MS=30000
REQUEST_TIMEOUT_MS=35000
ROUTE_OPERATION_TIMEOUT_MS=12000

# --- Free-tier capacity tuning ---
# Max requests this single instance holds in flight before returning 503
# instead of risking an OOM crash under a burst. Lower on smaller instances.
MAX_CONCURRENT_REQUESTS=300
# Must stay under your Postgres plan's total connection cap (free tiers are
# often 20-100 shared across everything hitting the DB).
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=10
# Live order updates already work via polling; WS is a latency optimization
# only. Set to false to shed the per-connection memory/heartbeat overhead.
ENABLE_WS=true
AUTH_USER_CACHE_TTL_MS=15000
AUTH_DB_LOOKUP_TIMEOUT_MS=7000
AUTH_QUEUE_WAIT_MS=8000
SECURITY_EVENT_BUFFER_SIZE=5000

SECURITY_INGEST_KEY=change-me-long-random-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_ALERT_MIN_SEVERITY=medium
TELEGRAM_ALERT_DEDUPE_MS=30000
TELEGRAM_ALERT_FLUSH_MS=2000
SLACK_ALERT_WEBHOOK_URL=
SECURITY_SETTINGS_ENCRYPTION_KEY=change-this-32-byte-plus-secret

# Firebase Admin credentials: set ONE option below in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
